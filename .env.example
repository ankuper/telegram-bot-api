# Copy to .env and fill in. Do NOT commit .env.
# --- Type3 / teleproto3 proxy (required) ---
T3_PROXY_HOST=your-proxy.example.com
T3_PROXY_PORT=443
T3_SECRET=ff00000000000000000000000000000000example.com

# --- Telegram app credentials (optional; bundled default used if unset) ---
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# --- local server ---
BOT_API_PORT=8081

# --- smoke test only (NEVER commit a real token) ---
BOT_TOKEN=
